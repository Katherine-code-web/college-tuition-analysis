# Copy this file to .env and fill in your API keys
# College Scorecard API — free key at: https://api.data.gov/signup/
COLLEGE_SCORECARD_API_KEY=your_api_key_here

# Google Gemini API — free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_key_here

# Anthropic Claude API — get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Set to true to run zero-cost demos (no API calls made)
DEMO_MODE=false

# Max agent runs per session (protects against runaway costs)
DAILY_AGENT_RUN_LIMIT=5
